{
  "manifest_version": 3,
  "name": "KIKO AI — MindGuard",
  "version": "1.0.0",
  "description": "Focus monitoring for your KIKO AI study sessions.",
  "permissions": [
    "tabs",
    "storage",
    "notifications",
    "alarms",
    "idle"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "KIKO AI"
  }
}